# Application Settings
PROJECT_NAME="QuizForge"
API_V1_STR="/api/v1"
SECRET_KEY="change_this_to_a_very_secure_secret_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Settings
# For Docker Compose, host is usually 'db'. For local host is 'localhost'.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quizforge"

# Seed Admin User Settings
FIRST_SUPERUSER_EMAIL="admin@quizforge.com"
FIRST_SUPERUSER_PASSWORD="adminpassword123"

# Email Configuration (Simulated/SMTP)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-smtp-password"
EMAILS_FROM_EMAIL="noreply@quizforge.com"
EMAILS_FROM_NAME="QuizForge Assessments"
